;;;; The REPL buffer
;;;;
;;;; Part of DOSLIB: Common Lisp on DOS with SBCL.

(in-package #:doslib-emacs)

(defun repl-buffer ()
  (or (find-buf "*repl*")
      (let ((b (make-buf "*repl*")))
        (setf (buf-mode b) 'repl-mode)
        (setf (aref (buf-lines b) 0)
              (format nil "; ~A ~A on ~A ~A" (lisp-implementation-type)
                      (lisp-implementation-version) (software-type) (software-version)))
        (let ((*buf* b)) (repl-prompt))
        (setf (buf-modified b) nil)
        b)))
(defun repl-emit (string)               ; at the end of the buffer
  (end-of-buffer)
  (insert string))
(defun repl-prompt-text ()               ; the package's shortest name
  (format nil "~A> " (first (sort (cons (package-name *repl-package*)
                                        (copy-list (package-nicknames *repl-package*)))
                                  #'< :key #'length))))
(defun repl-prompt ()
  (end-of-buffer)
  (unless (string= (current-line) "") (insert (string #\Newline)))
  (setf (buf-prompt *buf*) (repl-prompt-text))
  (insert (buf-prompt *buf*))
  (setf (buf-undo *buf*) nil (buf-modified *buf*) nil))
(defun repl-prompt-line (&optional (b *buf*))
  (let ((prompt (buf-prompt b)))
    (and prompt
         (loop for i from (1- (nlines b)) downto 0
               when (eql (search prompt (line-text i b)) 0) return i))))
(defun repl-input ()
  (let ((line (repl-prompt-line)) (last (1- (nlines))))
    (text-between line (length (buf-prompt *buf*)) last (length (line-text last)))))
(define-command repl-return ()
  "Evaluate the input at the prompt, if it is complete; otherwise start a new line."
  (let ((prompt-line (repl-prompt-line)))
    (if (or (null prompt-line) (< (point-line) prompt-line))
        (end-of-buffer)
        (let ((input (repl-input)))
          (multiple-value-bind (forms status) (read-forms input)
            (cond ((eq status :incomplete) (newline-and-indent))
                  ((not (eq status :ok))
                   (repl-emit (format nil "~%; Can't read that: ~A" status)) (repl-prompt))
                  (t (unless (string= (string-trim '(#\Space #\Newline) input) "")
                       (push input (buf-history *buf*)))
                     (setf (buf-history-index *buf*) -1)
                     (let ((repl *buf*))
                       (dolist (form forms)
                         (setf - form)
                         (multiple-value-bind (values output condition) (eval-captured form)
                           (let ((*buf* repl))
                             (repl-emit (string #\Newline))
                             (repl-emit (string-right-trim '(#\Newline) output))
                             (unless (string= (current-line) "") (repl-emit (string #\Newline)))
                             (cond (condition
                                    (repl-emit (format nil "; Evaluation aborted on ~A:~%; ~A"
                                                       (type-of condition)
                                                       (one-line (princ-to-string condition)))))
                                   (t (setf +++ ++ ++ + + form *** ** ** * * (first values)
                                            /// // // / / values)
                                      (repl-emit (printed values)))))))
                       (let ((*buf* repl)) (repl-prompt))))))))))
(defun repl-history (step)
  (let* ((history (buf-history *buf*))
         (index (max -1 (min (1- (length history)) (+ (buf-history-index *buf*) step))))
         (line (repl-prompt-line)) (last (1- (nlines))))
    (delete-between line (length (buf-prompt *buf*)) last (length (line-text last)))
    (end-of-buffer)
    (when (>= index 0) (insert (nth index history)))
    (setf (buf-history-index *buf*) index)))
(define-command repl-previous-input () "Recall the previous input." (repl-history 1))
(define-command repl-next-input () "Recall the next input." (repl-history -1))
(define-command repl-beginning-of-line () "Move to the start of the input, or of the line."
  (let ((prompt (buf-prompt *buf*)))
    (goto (point-line)
          (if (and prompt (eql (search prompt (current-line)) 0) (> (point-col) (length prompt)))
              (length prompt)
              0))))
(defun repl-new-prompt ()
  "Write the prompt on the input line again: the REPL's package has changed."
  (let ((line (repl-prompt-line)) (old (buf-prompt *buf*)) (new (repl-prompt-text)))
    (when (and line (string/= old new))
      (setf (aref (buf-lines *buf*) line)
            (concatenate 'string new (subseq (line-text line) (length old)))
            (buf-prompt *buf*) new)
      (when (= (point-line) line)
        (goto line (max (length new) (+ (point-col) (- (length new) (length old)))))))))
(define-command repl-clear () "Empty the REPL buffer and start again at a prompt."
  (let ((b (repl-buffer)))
    (let ((*buf* b))
      (setf (fill-pointer (buf-lines b)) 0)
      (vector-push-extend "" (buf-lines b))
      (setf (buf-line b) 0 (buf-col b) 0)
      (repl-prompt))
    (dolist (w *windows*) (when (eq (win-buf w) b) (setf (win-top w) 0 (win-point w) nil)))))
(define-command repl-search-history ()
  "Recall the most recent input that contains some text."
  (let* ((text (read-string "Recall the input containing: "))
         (index (position-if (lambda (input) (search text input :test #'char-equal))
                             (buf-history *buf*))))
    (unless index (editor-error "No input contained ~A" text))
    (setf (buf-history-index *buf*) -1)
    (repl-history (1+ index))))
