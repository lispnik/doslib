;;;; Keys
;;;;
;;;; Part of DOSLIB: Common Lisp on DOS with SBCL.

(in-package #:doslib-emacs)

(dolist (binding
         '(("C-f" forward-char) ("<right>" forward-char) ("C-b" backward-char) ("<left>" backward-char)
           ("C-n" next-line) ("<down>" next-line) ("C-p" previous-line) ("<up>" previous-line)
           ("C-a" beginning-of-line) ("<home>" beginning-of-line) ("C-e" end-of-line) ("<end>" end-of-line)
           ("M-<" beginning-of-buffer) ("C-<home>" beginning-of-buffer)
           ("M->" end-of-buffer) ("C-<end>" end-of-buffer)
           ("C-v" scroll-up) ("<next>" scroll-up) ("M-v" scroll-down) ("<prior>" scroll-down)
           ("M-f" forward-word) ("C-<right>" forward-word) ("M-b" backward-word) ("C-<left>" backward-word)
           ("C-l" recenter) ("M-g" goto-line)
           ("RET" newline) ("C-j" newline-and-indent) ("C-o" open-line) ("TAB" tab-to-tab-stop)
           ("C-d" delete-char) ("<delete>" delete-char) ("<backspace>" delete-backward-char)
           ("C-k" kill-line) ("M-d" kill-word) ("M-<backspace>" backward-kill-word)
           ("C-SPC" set-mark) ("C-@" set-mark) ("C-x C-x" exchange-point-and-mark)
           ("C-x h" mark-whole-buffer) ("C-w" kill-region) ("M-w" copy-region) ("C-y" yank)
           ("C-_" undo) ("C-x u" undo) ("M-_" redo) ("C-x r" redo) ("C-g" keyboard-quit)
           ("<f3>" start-macro) ("C-x (" start-macro) ("C-x )" end-macro)
           ("<f4>" end-or-call-macro) ("C-x e" call-macro) ("C-q" quoted-insert)
           ("C-s" isearch-forward) ("C-r" isearch-backward) ("M-%" replace-string)
           ("C-x C-f" find-file) ("C-x C-s" save-buffer) ("<f2>" save-buffer) ("C-x C-w" write-file)
           ("C-x b" switch-to-buffer) ("C-x k" kill-buffer) ("C-x C-b" list-buffers)
           ("C-x 2" split-window) ("C-x 1" delete-other-windows) ("C-x o" other-window)
           ("C-x C-e" eval-last-sexp) ("C-c C-c" eval-defun) ("C-c C-b" eval-buffer)
           ("M-:" eval-expression) ("C-c C-z" switch-to-repl) ("C-c C-l" load-file)
           ("M-x" execute-command) ("C-x C-c" exit-editor)
           ("C-h k" describe-key) ("C-h b" describe-bindings) ("C-h f" describe-function)
           ("<f1>" describe-bindings)))
  (bind-key (first binding) (second binding)))
(setf (get 'lisp-mode 'mode-name) "Lisp" (get 'repl-mode 'mode-name) "REPL"
      (get 'fundamental-mode 'mode-name) "Text")
(setf (get 'dired-mode 'mode-name) "Dired")
(bind-key "C-x d" 'dired)
(dolist (binding
         '(("RET" dired-find-file) ("f" dired-find-file) ("e" dired-find-file)
           ("o" dired-find-file-other-window) ("^" dired-up-directory) ("g" dired-refresh)
           ("n" dired-next-line) ("SPC" dired-next-line) ("<down>" dired-next-line)
           ("p" dired-previous-line) ("<up>" dired-previous-line)
           ("d" dired-flag-deletion) ("u" dired-unflag) ("U" dired-unflag-all) ("x" dired-execute)
           ("D" dired-delete) ("R" dired-rename) ("C" dired-copy) ("+" dired-create-directory)
           ("L" dired-load-file) ("s" dired-sort) ("q" dired-quit) ("?" dired-help) ("h" dired-help)))
  (bind-key (first binding) (second binding) 'dired-mode))
(bind-key "RET" 'newline-and-indent 'lisp-mode)
(bind-key "TAB" 'indent-line 'lisp-mode)
(bind-key "TAB" 'indent-line 'repl-mode)
(bind-key "RET" 'repl-return 'repl-mode)
(bind-key "M-p" 'repl-previous-input 'repl-mode)
(bind-key "M-n" 'repl-next-input 'repl-mode)
(bind-key "C-a" 'repl-beginning-of-line 'repl-mode)
(bind-key "<home>" 'repl-beginning-of-line 'repl-mode)
