;;;; DOSLIB: Common Lisp on DOS with SBCL.
;;;;
;;;;   doslib            the library: BIOS, DOS, ports, memory, video
;;;;   doslib/examples   programs that use it; (doslib-examples:menu) lists them
;;;;   doslib/emacs      an Emacs-like editor with a REPL, a debugger and Dired
;;;;   doslib/emacs-extras   more for the editor: modes and commands that use
;;;;                     the examples and the network

(defsystem "doslib"
  :description "BIOS, DOS, port and memory access for SBCL on DOS."
  :version "0.2.0"
  :pathname "src"
  :serial t
  :components ((:file "compat")
               (:file "package")
               (:file "machine")
               (:file "ports")
               (:file "dos")
               (:file "cpuid")
               (:file "memory")
               (:file "interrupts")
               (:file "hotkey")
               (:file "video")
               (:file "gtext")
               (:file "modex")
               (:file "input")
               (:file "text")
               (:file "critical")
               (:file "dialog")
               (:file "sound")
               (:file "mouse")
               (:file "disk")
               (:file "dma")
               (:file "irq")
               (:file "keystate")
               (:file "blaster")
               (:file "pci")
               (:file "serial")
               (:file "clipboard")
               (:file "init")))

(defsystem "doslib/examples"
  :description "Example programs for DOSLIB: graphics, system information, Lisp, networking."
  :version "0.2.0"
  :depends-on ("doslib" (:feature :sbcl "sb-bsd-sockets"))
  :pathname "examples"
  :components ((:file "package")
               (:file "sockets")
               (:module "graphics"
                :depends-on ("package")
                :components ((:file "blit")
                             (:file "bmpview")
                             (:file "compiled")
                             (:file "copper")
                             (:file "dirty")
                             (:file "fire")
                             (:file "formula")
                             (:file "flip")
                             (:file "font")
                             (:file "gcviz")
                             (:file "latch")
                             (:file "lfb")
                             (:file "lsystem")
                             (:file "mandel")
                             (:file "modex")
                             (:file "paint")
                             (:file "plasma")
                             (:file "raycast")
                             (:file "raytrace")
                             (:file "scroll")
                             (:file "sprite")
                             (:file "stars")
                             (:file "textfx")
                             (:file "turtle")
                             (:file "vesa")
                             (:file "wire3d")
                             (:file "mode12")
                             (:file "palette")
                             (:file "palettes")
                             (:file "shapes")
                             (:file "parallax")
                             (:file "picview")
                             (:file "rotozoom")
                             (:file "solid3d")
                             (:file "split")
                             (:file "textfont")
                             (:file "tiles")
                             (:file "tunnel")))
               (:module "system"
                :depends-on ("package")
                :components ((:file "asm")
                             (:file "asmdsl")
                             (:file "driver")
                             (:file "vop")
                             (:file "calc")
                             (:file "fatview")
                             (:file "floppy")
                             (:file "printer")
                             (:file "probes")
                             (:file "diskinfo")
                             (:file "dosinfo")
                             (:file "intvec")
                             (:file "ivt")
                             (:file "mcbwalk")
                             (:file "memmap")
                             (:file "pciscan")
                             (:file "ports")
                             (:file "serial")
                             (:file "alarm")
                             (:file "cdrom")
                             (:file "joystick")
                             (:file "keys")
                             (:file "term")
                             (:file "xms")
                             (:file "speed")
                             (:file "step")
                             (:file "sysinfo")
                             (:file "timer")))
               (:module "lisp"
                :depends-on ("package")
                :components ((:file "bench")
                             (:file "hotfix")
                             (:file "faults")
                             (:file "life")
                             (:file "live")
                             (:file "restarts")
                             (:file "resume")
                             (:file "shell")
                             (:file "snake")
                             (:file "special")
                             (:file "windows")))
               (:module "sound"
                :depends-on ("package")
                :components ((:file "adlib")     ; and the notation both use
                             (:file "blaster")
                             (:file "dmascope")
                             (:file "modplay")
                             (:file "record")
                             (:file "midi")
                             (:file "mixer")
                             (:file "spectrum")
                             (:file "tune")
                             (:file "speaker" :depends-on ("adlib"))))
               (:module "network"
                :depends-on ("package" "sockets")
                :components ((:file "browse")
                             (:file "files")
                             (:file "irc")
                             (:file "netpong")
                             (:file "ntp")
                             (:file "remote")
                             (:file "websrv")
                             (:file "wget")))))

(defsystem "doslib/emacs"
  :description "An Emacs-like text editor for DOS, written in and extended with Common Lisp."
  :version "0.2.0"
  :depends-on ("doslib")
  :pathname "emacs"
  :serial t
  :components ((:file "package")
               (:file "compat")
               (:file "buffers")
               (:file "screen")
               (:file "keyboard")
               (:file "keymaps")
               (:file "minibuffer")
               (:file "movement")
               (:file "editing")
               (:file "search")
               (:file "lisp")
               (:file "sexp")
               (:file "lisptools")
               (:file "repl")
               (:file "files")
               (:file "dired")
               (:file "windows")
               (:file "inspect")
               (:file "help")
               (:file "macros")
               (:file "keys")
               (:file "main")))

(defsystem "doslib/emacs-extras"
  :description "More for the editor: commands and modes built on the examples and the network."
  :version "0.2.0"
  :depends-on ("doslib/emacs" "doslib/examples")
  :pathname "emacs-extras"
  :components ((:file "commands")
               (:file "mouse")
               (:file "hex")
               (:file "web")
               (:file "irc")
               (:file "games")
               (:file "live")))
